{
  "author": "Thuan Nguyen <huuthuan.nguyen@hotmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/huuthuan-nguyen/dsh-knowcode"
  },
  "homepage": "https://github.com/huuthuan-nguyen/dsh-knowcode#readme",
  "name": "dsh-knowcode",
  "version": "0.1.5",
  "description": "Unified Code Graph & Knowledge Base Plugin for DeepSeek Harness powered by Embedded FalkorDB",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "knowcode": "./bin/knowcode.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && chmod +x bin/knowcode.js",
    "test": "node --test tests/*.test.ts",
    "link-deps": "node scripts/link-official-deps.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "codegraph",
    "knowledge-base",
    "falkordb",
    "graph-database",
    "cypher",
    "ast",
    "refactoring",
    "tgrep"
  ],
  "dependencies": {
    "falkordb": "^6.8.0",
    "commander": "^13.1.0",
    "chokidar": "^4.0.3",
    "ignore": "^7.0.3",
    "fast-glob": "^3.3.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
